              "const res = pm.response.json();\r",
              "\r",
              "const code = res.shortUrl.split('/').pop();\r",
              "\r",
              "pm.collectionVariables.set(\"shortCode\", code);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
